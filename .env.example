# ==========================================================
# FulkLink 开源版配置样例。安装向导会照着这个文件生成 .env。
# ==========================================================

# ---------- 站点 ----------
SITE_NAME="我的短链"
SITE_URL="https://example.com"
SITE_TAGLINE="短链、二维码、跳转记录"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE="Asia/Shanghai"
# 客户站固定为 client，不要改成 cloud
APP_MODE=client
# 开源版固定 free。不读授权码，也没有可升级的通道
EDITION_FORCE=free

# 安装向导会自动生成。换机器要连同数据库一起拷走
APP_KEY=

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fulklink
DB_USER=fulklink
DB_PASS=
# http 部署先设 false，上了 SSL 改成 true
COOKIE_SECURE=true

# ---------- 邮件 ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_NAME="我的短链"

# ---------- 备案与客服 ----------
COMPANY=""
ICP_BEIAN=
SUPPORT_QQ=
SUPPORT_EMAIL=""

# ---------- 短链 ----------
# 留空表示不限制目标域名，一行一个
SHORT_DOMAIN=
